rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Rôle de chaque compte (editor = gestion, viewer = consultation).
    // Créé et modifié uniquement depuis la console Firebase, jamais par les clients.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Données du plan de stockage (cellules, palox, historique).
    match /planStockage/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && userRole() == 'editor';
    }
  }
}
